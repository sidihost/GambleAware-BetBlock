rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Global Safety Net (Default-Deny)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Connection Probe Document (Startup Connectivity Check)
    // -------------------------------------------------------------------------
    match /test/connection {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 3: Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminEmailToken() {
      return isVerifiedUser() && request.auth.token.email == 'abdulhakemadeleke36@gmail.com';
    }

    function isAdmin() {
      return isAdminEmailToken() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function hasUserAnchor(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidOwnerField(data, userId) {
      return data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId;
    }

    // -------------------------------------------------------------------------
    // Phase 2: Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserRoot(data, userId) {
      return data.keys().hasAll(['ownerId', 'planTier', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'planTier', 'createdAt', 'updatedAt']) &&
        isValidOwnerField(data, userId) &&
        data.planTier is string &&
        data.planTier.size() <= 16 &&
        data.planTier == 'free' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['ownerId', 'email', 'displayName', 'preferredName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'displayName', 'preferredName', 'createdAt', 'updatedAt']) &&
        isValidOwnerField(data, userId) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        data.displayName is string &&
        data.displayName.size() <= 120 &&
        data.preferredName is string &&
        data.preferredName.size() <= 60 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'isProtectionEnabled',
          'blockSportsbooks',
          'blockCasinos',
          'blockPokerAndBingo',
          'blockCryptoBetting',
          'blockFantasyAndLottery',
          'strictKeywordFilter',
          'browserShieldEnabled',
          'appShieldEnabled',
          'searchGuardEnabled',
          'antiTamperLockEnabled',
          'lockUntilEpochMs',
          'pinHash',
          'protectionStartedAtMs',
          'dailyBetSpendEstimate',
          'themeMode',
          'hasCompletedTour',
          'notificationsEnabled',
          'lastNotifiedMilestoneDay',
          'aiAutoBlockEnabled',
          'goalReminderEnabled',
          'isAccessibilityEnabled',
          'isDeviceAdminEnabled',
          'privateDnsActive',
          'privateDnsHost',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'isProtectionEnabled',
          'blockSportsbooks',
          'blockCasinos',
          'blockPokerAndBingo',
          'blockCryptoBetting',
          'blockFantasyAndLottery',
          'strictKeywordFilter',
          'browserShieldEnabled',
          'appShieldEnabled',
          'searchGuardEnabled',
          'antiTamperLockEnabled',
          'lockUntilEpochMs',
          'pinHash',
          'protectionStartedAtMs',
          'dailyBetSpendEstimate',
          'themeMode',
          'hasCompletedTour',
          'notificationsEnabled',
          'lastNotifiedMilestoneDay',
          'aiAutoBlockEnabled',
          'goalReminderEnabled',
          'isAccessibilityEnabled',
          'isDeviceAdminEnabled',
          'privateDnsActive',
          'privateDnsHost',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidOwnerField(data, userId) &&
        data.isProtectionEnabled is bool &&
        data.blockSportsbooks is bool &&
        data.blockCasinos is bool &&
        data.blockPokerAndBingo is bool &&
        data.blockCryptoBetting is bool &&
        data.blockFantasyAndLottery is bool &&
        data.strictKeywordFilter is bool &&
        data.browserShieldEnabled is bool &&
        data.appShieldEnabled is bool &&
        data.searchGuardEnabled is bool &&
        data.antiTamperLockEnabled is bool &&
        data.lockUntilEpochMs is number &&
        data.lockUntilEpochMs >= 0 &&
        data.pinHash is string &&
        data.pinHash.size() <= 64 &&
        data.protectionStartedAtMs is number &&
        data.protectionStartedAtMs >= 0 &&
        data.dailyBetSpendEstimate is number &&
        data.dailyBetSpendEstimate >= 0 &&
        data.dailyBetSpendEstimate <= 10000000 &&
        data.themeMode is string &&
        data.themeMode.size() <= 16 &&
        data.themeMode in ['SYSTEM', 'LIGHT', 'DARK'] &&
        data.hasCompletedTour is bool &&
        data.notificationsEnabled is bool &&
        data.lastNotifiedMilestoneDay is number &&
        data.lastNotifiedMilestoneDay >= 0 &&
        data.lastNotifiedMilestoneDay <= 36500 &&
        data.aiAutoBlockEnabled is bool &&
        data.goalReminderEnabled is bool &&
        data.isAccessibilityEnabled is bool &&
        data.isDeviceAdminEnabled is bool &&
        data.privateDnsActive is bool &&
        data.privateDnsHost is string &&
        data.privateDnsHost.size() <= 253 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserGoal(data, userId, docId) {
      return data.keys().hasAll([
          'ownerId',
          'goalId',
          'title',
          'category',
          'targetDays',
          'targetAmountNgn',
          'whyNote',
          'isPrimary',
          'isCompleted',
          'lockDurationDays',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'goalId',
          'title',
          'category',
          'targetDays',
          'targetAmountNgn',
          'whyNote',
          'isPrimary',
          'isCompleted',
          'lockDurationDays',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidOwnerField(data, userId) &&
        data.goalId is string &&
        data.goalId == docId &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 100 &&
        data.category is string &&
        data.category.size() <= 24 &&
        data.category in ['savings', 'streak', 'milestone'] &&
        data.targetDays is number &&
        data.targetDays >= 1 &&
        data.targetDays <= 3650 &&
        data.targetAmountNgn is number &&
        data.targetAmountNgn >= 0 &&
        data.targetAmountNgn <= 100000000 &&
        data.whyNote is string &&
        data.whyNote.size() <= 280 &&
        data.isPrimary is bool &&
        data.isCompleted is bool &&
        data.lockDurationDays is number &&
        data.lockDurationDays >= 0 &&
        data.lockDurationDays <= 365 &&
        data.createdAtMs is number &&
        data.createdAtMs > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomDomainRule(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'domain',
          'isAllowlisted',
          'categoryName',
          'addedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'domain',
          'isAllowlisted',
          'categoryName',
          'addedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidOwnerField(data, userId) &&
        data.domain is string &&
        data.domain.size() >= 3 &&
        data.domain.size() <= 253 &&
        data.domain.matches('^[a-z0-9.-]+\\.[a-z]{2,}$') &&
        data.isAllowlisted is bool &&
        data.categoryName is string &&
        data.categoryName.size() >= 1 &&
        data.categoryName.size() <= 64 &&
        data.addedAt is number &&
        data.addedAt >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBlockedAppRule(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'packageName',
          'appLabel',
          'addedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'packageName',
          'appLabel',
          'addedAt',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidOwnerField(data, userId) &&
        data.packageName is string &&
        data.packageName.size() >= 3 &&
        data.packageName.size() <= 160 &&
        data.packageName.matches('^[a-zA-Z0-9_.]+$') &&
        data.appLabel is string &&
        data.appLabel.size() >= 1 &&
        data.appLabel.size() <= 80 &&
        data.addedAt is number &&
        data.addedAt >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBlockedEvent(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'eventId',
          'target',
          'source',
          'categoryName',
          'timestamp',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'eventId',
          'target',
          'source',
          'categoryName',
          'timestamp',
          'createdAt'
        ]) &&
        isValidOwnerField(data, userId) &&
        data.eventId is number &&
        data.eventId > 0 &&
        data.target is string &&
        data.target.size() >= 1 &&
        data.target.size() <= 253 &&
        data.source is string &&
        data.source.size() <= 32 &&
        data.source in ['Web Shield', 'In-App WebView', 'App Shield', 'Install Guard', 'AI Agent'] &&
        data.categoryName is string &&
        data.categoryName.size() >= 1 &&
        data.categoryName.size() <= 64 &&
        data.timestamp is number &&
        data.timestamp > 0 &&
        data.createdAt is timestamp;
    }

    function isValidUrgeLog(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'logId',
          'triggerTag',
          'note',
          'timestamp',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'logId',
          'triggerTag',
          'note',
          'timestamp',
          'createdAt'
        ]) &&
        isValidOwnerField(data, userId) &&
        data.logId is number &&
        data.logId > 0 &&
        data.triggerTag is string &&
        data.triggerTag.size() >= 1 &&
        data.triggerTag.size() <= 40 &&
        data.note is string &&
        data.note.size() <= 280 &&
        data.timestamp is number &&
        data.timestamp > 0 &&
        data.createdAt is timestamp;
    }

    function isValidRecoverySurvey(data, userId, docId) {
      return data.keys().hasAll([
          'ownerId',
          'surveyId',
          'primaryFormat',
          'triggersSummary',
          'spendBand',
          'relapseFrequency',
          'peakWindow',
          'supportReadiness',
          'riskScore',
          'riskTier',
          'recommendedLockDays',
          'summary',
          'completedAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'surveyId',
          'primaryFormat',
          'triggersSummary',
          'spendBand',
          'relapseFrequency',
          'peakWindow',
          'supportReadiness',
          'riskScore',
          'riskTier',
          'recommendedLockDays',
          'summary',
          'completedAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidOwnerField(data, userId) &&
        data.surveyId is string &&
        data.surveyId == docId &&
        data.primaryFormat is string &&
        data.primaryFormat.size() >= 1 &&
        data.primaryFormat.size() <= 60 &&
        data.triggersSummary is string &&
        data.triggersSummary.size() >= 1 &&
        data.triggersSummary.size() <= 240 &&
        data.spendBand is string &&
        data.spendBand.size() >= 1 &&
        data.spendBand.size() <= 60 &&
        data.relapseFrequency is string &&
        data.relapseFrequency.size() >= 1 &&
        data.relapseFrequency.size() <= 60 &&
        data.peakWindow is string &&
        data.peakWindow.size() >= 1 &&
        data.peakWindow.size() <= 60 &&
        data.supportReadiness is string &&
        data.supportReadiness.size() >= 1 &&
        data.supportReadiness.size() <= 60 &&
        data.riskScore is number &&
        data.riskScore >= 0 &&
        data.riskScore <= 100 &&
        data.riskTier is string &&
        data.riskTier in ['LOW', 'MODERATE', 'HIGH', 'CRITICAL'] &&
        data.recommendedLockDays is number &&
        data.recommendedLockDays >= 0 &&
        data.recommendedLockDays <= 730 &&
        data.summary is string &&
        data.summary.size() >= 1 &&
        data.summary.size() <= 500 &&
        data.completedAtMs is number &&
        data.completedAtMs > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRecoveryProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'email',
          'displayName',
          'preferredName',
          'isProtectionEnabled',
          'isLocked',
          'lockUntilEpochMs',
          'dailyBetSpendEstimate',
          'cleanDays',
          'estimatedSavedNgn',
          'totalBlockedCount',
          'totalUrgeResistedCount',
          'relapseCount',
          'surveyRiskTier',
          'surveyPrimaryFormat',
          'lastActiveMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'email',
          'displayName',
          'preferredName',
          'isProtectionEnabled',
          'isLocked',
          'lockUntilEpochMs',
          'dailyBetSpendEstimate',
          'cleanDays',
          'estimatedSavedNgn',
          'totalBlockedCount',
          'totalUrgeResistedCount',
          'relapseCount',
          'surveyRiskTier',
          'surveyPrimaryFormat',
          'lastActiveMs',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidOwnerField(data, userId) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        data.displayName is string &&
        data.displayName.size() <= 120 &&
        data.preferredName is string &&
        data.preferredName.size() <= 60 &&
        data.isProtectionEnabled is bool &&
        data.isLocked is bool &&
        data.lockUntilEpochMs is number &&
        data.lockUntilEpochMs >= 0 &&
        data.dailyBetSpendEstimate is number &&
        data.dailyBetSpendEstimate >= 0 &&
        data.dailyBetSpendEstimate <= 10000000 &&
        data.cleanDays is number &&
        data.cleanDays >= 0 &&
        data.cleanDays <= 36500 &&
        data.estimatedSavedNgn is number &&
        data.estimatedSavedNgn >= 0 &&
        data.estimatedSavedNgn <= 10000000000 &&
        data.totalBlockedCount is number &&
        data.totalBlockedCount >= 0 &&
        data.totalUrgeResistedCount is number &&
        data.totalUrgeResistedCount >= 0 &&
        data.relapseCount is number &&
        data.relapseCount >= 0 &&
        data.surveyRiskTier is string &&
        data.surveyRiskTier in ['UNASSESSED', 'LOW', 'MODERATE', 'HIGH', 'CRITICAL'] &&
        data.surveyPrimaryFormat is string &&
        data.surveyPrimaryFormat.size() <= 60 &&
        data.lastActiveMs is number &&
        data.lastActiveMs > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSupportTicket(data, ticketId) {
      return data.keys().hasAll([
          'ticketId',
          'ownerId',
          'userEmail',
          'userName',
          'category',
          'urgency',
          'subject',
          'message',
          'status',
          'adminReply',
          'respondedByEmail',
          'respondedAtMs',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ticketId',
          'ownerId',
          'userEmail',
          'userName',
          'category',
          'urgency',
          'subject',
          'message',
          'status',
          'adminReply',
          'respondedByEmail',
          'respondedAtMs',
          'createdAtMs',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ticketId is string &&
        data.ticketId == ticketId &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.userEmail is string &&
        data.userEmail.size() >= 3 &&
        data.userEmail.size() <= 254 &&
        data.userEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        data.userName is string &&
        data.userName.size() <= 120 &&
        data.category is string &&
        data.category in ['RECOVERY_HELP', 'RELAPSE_SUPPORT', 'BLOCKER_ISSUE', 'LOCK_OR_PIN', 'BANK_EXCLUSION'] &&
        data.urgency is string &&
        data.urgency in ['STANDARD', 'HIGH', 'URGENT'] &&
        data.subject is string &&
        data.subject.size() >= 3 &&
        data.subject.size() <= 140 &&
        data.message is string &&
        data.message.size() >= 5 &&
        data.message.size() <= 2000 &&
        data.status is string &&
        data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED'] &&
        data.adminReply is string &&
        data.adminReply.size() <= 2000 &&
        data.respondedByEmail is string &&
        data.respondedByEmail.size() <= 254 &&
        data.respondedAtMs is number &&
        data.respondedAtMs >= 0 &&
        data.createdAtMs is number &&
        data.createdAtMs > 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRole(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string &&
        data.uid == adminId &&
        isValidId(data.uid) &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.role is string &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Phase 6: Final Production Collection Rules
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdminEmailToken();
      allow create, update, delete: if isAdmin() &&
        isValidId(adminId) &&
        isValidAdminRole(incoming(), adminId) &&
        incoming().createdAt == request.time;
    }

    match /recoveryProfiles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdminEmailToken() || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidRecoveryProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidRecoveryProfile(incoming(), userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'displayName',
          'preferredName',
          'isProtectionEnabled',
          'isLocked',
          'lockUntilEpochMs',
          'dailyBetSpendEstimate',
          'cleanDays',
          'estimatedSavedNgn',
          'totalBlockedCount',
          'totalUrgeResistedCount',
          'relapseCount',
          'surveyRiskTier',
          'surveyPrimaryFormat',
          'lastActiveMs',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) &&
        (isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid));
      allow list: if isAdminEmailToken() || (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isVerifiedUser() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming(), ticketId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'OPEN' &&
        incoming().adminReply == '' &&
        incoming().respondedByEmail == '' &&
        incoming().respondedAtMs == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(ticketId) &&
        isValidSupportTicket(incoming(), ticketId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().ticketId == existing().ticketId &&
        incoming().createdAtMs == existing().createdAtMs &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'adminReply',
              'respondedByEmail',
              'respondedAtMs',
              'updatedAt'
            ])
          ) ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().status in ['OPEN', 'CLOSED'] &&
            incoming().adminReply == existing().adminReply &&
            incoming().respondedByEmail == existing().respondedByEmail &&
            incoming().respondedAtMs == existing().respondedAtMs &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'subject',
              'message',
              'status',
              'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(ticketId) &&
        (isAdmin() || existing().ownerId == request.auth.uid);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdminEmailToken();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserRoot(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserRoot(incoming(), userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      // Isolated PII Collection (email, displayName, preferredName)
      match /private/{docId} {
        allow get: if isValidId(userId) &&
          isValidId(docId) &&
          docId == 'account' &&
          (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'account' &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'account' &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'preferredName', 'updatedAt']);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(docId) && isOwner(userId);
      }

      // Protection Profile & Blocker Settings (with Server-Side Commitment Lock Integrity)
      match /profile/{docId} {
        allow get: if isValidId(userId) &&
          isValidId(docId) &&
          docId == 'settings' &&
          (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'settings' &&
          isOwner(userId) &&
          isValidUserSettings(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'settings' &&
          isOwner(userId) &&
          isValidUserSettings(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            existing().lockUntilEpochMs <= request.time.toMillis() ||
            (
              incoming().lockUntilEpochMs >= existing().lockUntilEpochMs &&
              incoming().isProtectionEnabled == true &&
              incoming().antiTamperLockEnabled == true &&
              (existing().pinHash == '' || incoming().pinHash == existing().pinHash)
            )
          ) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'isProtectionEnabled',
            'blockSportsbooks',
            'blockCasinos',
            'blockPokerAndBingo',
            'blockCryptoBetting',
            'blockFantasyAndLottery',
            'strictKeywordFilter',
            'browserShieldEnabled',
            'appShieldEnabled',
            'searchGuardEnabled',
            'antiTamperLockEnabled',
            'lockUntilEpochMs',
            'pinHash',
            'protectionStartedAtMs',
            'dailyBetSpendEstimate',
            'themeMode',
            'hasCompletedTour',
            'notificationsEnabled',
            'lastNotifiedMilestoneDay',
            'aiAutoBlockEnabled',
            'goalReminderEnabled',
            'isAccessibilityEnabled',
            'isDeviceAdminEnabled',
            'privateDnsActive',
            'privateDnsHost',
            'updatedAt'
          ]);
        allow delete: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          isOwner(userId) &&
          existing().lockUntilEpochMs <= request.time.toMillis();
      }

      // Personalized Recovery & Savings Goals
      match /goals/{goalId} {
        allow get: if isValidId(userId) && isValidId(goalId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(goalId) &&
          isOwner(userId) &&
          isValidUserGoal(incoming(), userId, goalId) &&
          hasUserAnchor(userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(goalId) &&
          isOwner(userId) &&
          isValidUserGoal(incoming(), userId, goalId) &&
          hasUserAnchor(userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().goalId == existing().goalId &&
          incoming().createdAtMs == existing().createdAtMs &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'category',
            'targetDays',
            'targetAmountNgn',
            'whyNote',
            'isPrimary',
            'isCompleted',
            'lockDurationDays',
            'updatedAt'
          ]);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(goalId) && isOwner(userId);
      }

      // Personalized Recovery Surveys
      match /surveys/{surveyId} {
        allow get: if isValidId(userId) && isValidId(surveyId) && (isOwner(userId) || isAdmin());
        allow list: if isAdminEmailToken() || (isOwner(userId) && existing().ownerId == request.auth.uid);
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(surveyId) &&
          isOwner(userId) &&
          isValidRecoverySurvey(incoming(), userId, surveyId) &&
          hasUserAnchor(userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(surveyId) &&
          isOwner(userId) &&
          isValidRecoverySurvey(incoming(), userId, surveyId) &&
          hasUserAnchor(userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().surveyId == existing().surveyId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'primaryFormat',
            'triggersSummary',
            'spendBand',
            'relapseFrequency',
            'peakWindow',
            'supportReadiness',
            'riskScore',
            'riskTier',
            'recommendedLockDays',
            'summary',
            'completedAtMs',
            'updatedAt'
          ]);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(surveyId) && isOwner(userId);
      }

      // Custom Domain Rules (Blocked & Allowlisted)
      match /domains/{domainId} {
        allow get: if isValidId(userId) && isValidId(domainId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(domainId) &&
          isOwner(userId) &&
          isValidCustomDomainRule(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(domainId) &&
          isOwner(userId) &&
          isValidCustomDomainRule(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'isAllowlisted',
            'categoryName',
            'addedAt',
            'updatedAt'
          ]);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(domainId) && isOwner(userId);
      }

      // Custom Blocked Apps
      match /blockedApps/{packageId} {
        allow get: if isValidId(userId) && isValidId(packageId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(packageId) &&
          isOwner(userId) &&
          isValidBlockedAppRule(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(packageId) &&
          isOwner(userId) &&
          isValidBlockedAppRule(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'appLabel',
            'addedAt',
            'updatedAt'
          ]);
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(packageId) && isOwner(userId);
      }

      // Blocked Event Telemetry (Append-Only; Delete Allowed Only For Clear History)
      match /events/{eventId} {
        allow get: if isValidId(userId) && isValidId(eventId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(eventId) &&
          isOwner(userId) &&
          isValidBlockedEvent(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(eventId) && isOwner(userId);
      }

      // Urge-Resisted Victory Journal (Append-Only)
      match /urgeLogs/{logId} {
        allow get: if isValidId(userId) && isValidId(logId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(logId) &&
          isOwner(userId) &&
          isValidUrgeLog(incoming(), userId) &&
          hasUserAnchor(userId) &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(logId) && isOwner(userId);
      }
    }
  }
}
