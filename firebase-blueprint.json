{
  "entities": {
    "UserRoot": {
      "title": "UserRoot",
      "description": "Root ownership anchor document enabling relational verification for user subcollections.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planTier": {
          "type": "string",
          "description": "Subscription tier indicator (always free).",
          "enum": ["free"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user anchor was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest anchor touch."
        }
      },
      "required": ["ownerId", "planTier", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing email, display name, and preferred greeting name accessible strictly to the owner.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "preferredName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "displayName", "preferredName", "createdAt", "updatedAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Persistent GambleAware blocker configuration, streak baseline, commitment lock, and UI preferences.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isProtectionEnabled": { "type": "boolean" },
        "blockSportsbooks": { "type": "boolean" },
        "blockCasinos": { "type": "boolean" },
        "blockPokerAndBingo": { "type": "boolean" },
        "blockCryptoBetting": { "type": "boolean" },
        "blockFantasyAndLottery": { "type": "boolean" },
        "strictKeywordFilter": { "type": "boolean" },
        "browserShieldEnabled": { "type": "boolean" },
        "appShieldEnabled": { "type": "boolean" },
        "searchGuardEnabled": { "type": "boolean" },
        "antiTamperLockEnabled": { "type": "boolean" },
        "lockUntilEpochMs": { "type": "number" },
        "pinHash": {
          "type": "string",
          "maxLength": 64
        },
        "protectionStartedAtMs": { "type": "number" },
        "dailyBetSpendEstimate": { "type": "number" },
        "themeMode": {
          "type": "string",
          "enum": ["SYSTEM", "LIGHT", "DARK"],
          "maxLength": 16
        },
        "hasCompletedTour": { "type": "boolean" },
        "notificationsEnabled": { "type": "boolean" },
        "lastNotifiedMilestoneDay": { "type": "number" },
        "aiAutoBlockEnabled": { "type": "boolean" },
        "goalReminderEnabled": { "type": "boolean" },
        "isAccessibilityEnabled": { "type": "boolean" },
        "isDeviceAdminEnabled": { "type": "boolean" },
        "privateDnsActive": { "type": "boolean" },
        "privateDnsHost": {
          "type": "string",
          "maxLength": 253
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "isProtectionEnabled",
        "blockSportsbooks",
        "blockCasinos",
        "blockPokerAndBingo",
        "blockCryptoBetting",
        "blockFantasyAndLottery",
        "strictKeywordFilter",
        "browserShieldEnabled",
        "appShieldEnabled",
        "searchGuardEnabled",
        "antiTamperLockEnabled",
        "lockUntilEpochMs",
        "pinHash",
        "protectionStartedAtMs",
        "dailyBetSpendEstimate",
        "themeMode",
        "hasCompletedTour",
        "notificationsEnabled",
        "lastNotifiedMilestoneDay",
        "aiAutoBlockEnabled",
        "goalReminderEnabled",
        "isAccessibilityEnabled",
        "isDeviceAdminEnabled",
        "privateDnsActive",
        "privateDnsHost",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserGoal": {
      "title": "UserGoal",
      "description": "Personalized betting-free recovery or Naira savings goal created by the user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "goalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["savings", "streak", "milestone"],
          "maxLength": 24
        },
        "targetDays": { "type": "number" },
        "targetAmountNgn": { "type": "number" },
        "whyNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 280
        },
        "isPrimary": { "type": "boolean" },
        "isCompleted": { "type": "boolean" },
        "lockDurationDays": { "type": "number" },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "goalId",
        "title",
        "category",
        "targetDays",
        "targetAmountNgn",
        "whyNote",
        "isPrimary",
        "isCompleted",
        "lockDurationDays",
        "createdAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomDomainRule": {
      "title": "CustomDomainRule",
      "description": "User-defined custom gambling block or safe allowlist domain rule.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "domain": {
          "type": "string",
          "minLength": 3,
          "maxLength": 253,
          "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
        },
        "isAllowlisted": { "type": "boolean" },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "addedAt": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "domain",
        "isAllowlisted",
        "categoryName",
        "addedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "BlockedAppRule": {
      "title": "BlockedAppRule",
      "description": "User-selected Android app package blocked by App Shield.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "packageName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_.]+$"
        },
        "appLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "addedAt": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "packageName",
        "appLabel",
        "addedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "BlockedEvent": {
      "title": "BlockedEvent",
      "description": "Recorded gambling site/app intercept telemetry event belonging strictly to owner.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": { "type": "number" },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "source": {
          "type": "string",
          "enum": ["Web Shield", "In-App WebView", "App Shield", "Install Guard", "AI Agent"],
          "maxLength": 32
        },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "eventId",
        "target",
        "source",
        "categoryName",
        "timestamp",
        "createdAt"
      ]
    },
    "UrgeLog": {
      "title": "UrgeLog",
      "description": "Personal urge-resisted recovery victory log entry.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "logId": { "type": "number" },
        "triggerTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "note": {
          "type": "string",
          "minLength": 0,
          "maxLength": 280
        },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "logId",
        "triggerTag",
        "note",
        "timestamp",
        "createdAt"
      ]
    },
    "RecoverySurvey": {
      "title": "RecoverySurvey",
      "description": "Personalized gambling recovery assessment and recommendation profile.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "surveyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "primaryFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "triggersSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "spendBand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "relapseFrequency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "peakWindow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "supportReadiness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "riskScore": { "type": "number" },
        "riskTier": {
          "type": "string",
          "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"],
          "maxLength": 16
        },
        "recommendedLockDays": { "type": "number" },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "completedAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "surveyId",
        "primaryFormat",
        "triggersSummary",
        "spendBand",
        "relapseFrequency",
        "peakWindow",
        "supportReadiness",
        "riskScore",
        "riskTier",
        "recommendedLockDays",
        "summary",
        "completedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "RecoveryProfile": {
      "title": "RecoveryProfile",
      "description": "Synced user recovery progress and survey risk summary readable by the owner and authorized admins.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "preferredName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "isProtectionEnabled": { "type": "boolean" },
        "isLocked": { "type": "boolean" },
        "lockUntilEpochMs": { "type": "number" },
        "dailyBetSpendEstimate": { "type": "number" },
        "cleanDays": { "type": "number" },
        "estimatedSavedNgn": { "type": "number" },
        "totalBlockedCount": { "type": "number" },
        "totalUrgeResistedCount": { "type": "number" },
        "relapseCount": { "type": "number" },
        "surveyRiskTier": {
          "type": "string",
          "enum": ["UNASSESSED", "LOW", "MODERATE", "HIGH", "CRITICAL"],
          "maxLength": 16
        },
        "surveyPrimaryFormat": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "lastActiveMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "email",
        "displayName",
        "preferredName",
        "isProtectionEnabled",
        "isLocked",
        "lockUntilEpochMs",
        "dailyBetSpendEstimate",
        "cleanDays",
        "estimatedSavedNgn",
        "totalBlockedCount",
        "totalUrgeResistedCount",
        "relapseCount",
        "surveyRiskTier",
        "surveyPrimaryFormat",
        "lastActiveMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Confidential recovery or technical support request submitted by a signed-in user for staff assistance.",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "userName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["RECOVERY_HELP", "RELAPSE_SUPPORT", "BLOCKER_ISSUE", "LOCK_OR_PIN", "BANK_EXCLUSION"],
          "maxLength": 32
        },
        "urgency": {
          "type": "string",
          "enum": ["STANDARD", "HIGH", "URGENT"],
          "maxLength": 16
        },
        "subject": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED"],
          "maxLength": 16
        },
        "adminReply": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "respondedByEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 254
        },
        "respondedAtMs": { "type": "number" },
        "createdAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ticketId",
        "ownerId",
        "userEmail",
        "userName",
        "category",
        "urgency",
        "subject",
        "message",
        "status",
        "adminReply",
        "respondedByEmail",
        "respondedAtMs",
        "createdAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Authorized GambleAware administrator role record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "maxLength": 16
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserRoot" },
      "description": "Owner root anchor document used by Master Gate subcollection checks."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII document strictly owned by userId or readable by admin."
    },
    "/users/{userId}/profile/{docId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "Synced protection settings & Naira baseline document (docId == settings)."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/UserGoal" },
      "description": "Personalized recovery and Naira savings goals."
    },
    "/users/{userId}/domains/{domainId}": {
      "schema": { "$ref": "#/entities/CustomDomainRule" },
      "description": "Custom blocked & allowlisted website domains."
    },
    "/users/{userId}/blockedApps/{packageId}": {
      "schema": { "$ref": "#/entities/BlockedAppRule" },
      "description": "User-added Android app package rules."
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/BlockedEvent" },
      "description": "Historical blocked intercept logs scoped to user."
    },
    "/users/{userId}/urgeLogs/{logId}": {
      "schema": { "$ref": "#/entities/UrgeLog" },
      "description": "Urge-resisted victory journal logs scoped to user."
    },
    "/users/{userId}/surveys/{surveyId}": {
      "schema": { "$ref": "#/entities/RecoverySurvey" },
      "description": "Personalized recovery assessment & recommendation profiles."
    },
    "/recoveryProfiles/{userId}": {
      "schema": { "$ref": "#/entities/RecoveryProfile" },
      "description": "User recovery telemetry & survey tier readable by owner or authorized admin."
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Confidential support tickets created by users and managed by authorized admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Allowlisted GambleAware admin role records."
    }
  }
}
