<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:dialogTheme">@style/Theme.MyApplication.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.MyApplication.AlertDialog</item>
    </style>

    <style name="Theme.MyApplication.Dialog" parent="android:Theme.DeviceDefault.Dialog">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.MyApplication.AlertDialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
